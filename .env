# in the bot's own .env exactly.
BOT_API_URL=https://np5x4rm046.apps.bot-hosting.cloud
BOT_API_KEY=sUM1BTTf6u-f|UXe

# NOTE: there is no OWNER_ID or HEAVEN_LAND_GUILD_ID here anymore.
